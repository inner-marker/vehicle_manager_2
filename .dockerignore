# Keep the image build context small and free of local state.
# Build output (rebuilt inside the image) and the Dioxus CLI's output
target/
dist/
# Experiments outside the workspace (phase-3.md 1e); not part of the image
spikes/

# Version control and editor/agent settings
.git/
.github/
.claude/
.DS_Store

# Local data that must never end up in an image
local/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.jsonl
.env
deploy/.env
# The geocoder data for development (the image builds its own, decision #059)
.geodata/
