# Settings for deploy/compose.yaml. Copy to `.env` in the Project folder on the NAS
# and fill in. Keep `.env` on the NAS; never commit it.

# Which server this is (decision #062). The household's main server: `vehiclemanager`, and
# INSTANCE empty. The test server beside it: `vehiclemanager-test`, and INSTANCE `test`.
# The Project name must match the Container Manager Project's name.
VEHICLEMANAGER_PROJECT_NAME=vehiclemanager
VEHICLEMANAGER_INSTANCE=

# Which image to run. The main server: a release, e.g. `0.2.0` (decision #070; it moves to
# a new release only when this is changed). The test server: `milestone-<name>` (newest
# build of a milestone branch, e.g. milestone-p2-m9-lifecycle), or `dev`. Either:
# `sha-<commit>` (an exact build, for pinning or rollback). `latest` isn't used on the NAS.
VEHICLEMANAGER_IMAGE_TAG=0.2.0

# The NAS user the container runs as: `id vehiclemanager` over SSH shows both.
VEHICLEMANAGER_UID=1030
VEHICLEMANAGER_GID=100

# Port on the NAS's loopback (127.0.0.1) that `tailscale serve` forwards to: 8410 for the
# main server, 8411 for the test server. Pick ones nothing else on the NAS uses (avoid DSM's
# 5000/5001).
VEHICLEMANAGER_HOST_PORT=8410

# Optional: where nightly snapshots go, as a path *inside the container*. Leave empty for
# the default, /data/snapshots (the Project's data/snapshots folder). Only for a second
# disk mounted in compose.yaml (e.g. /snapshots for a USB disk); that folder is never
# created, so an unmounted disk makes the snapshot "skipped" instead of filling the pool.
VEHICLEMANAGER_SNAPSHOT_DIR=

# Testing only, on the test server's milestone images: 1 to 5 makes Admin mode, sign-out, the nightly
# snapshot, the hourly check, and recovery codes use minutes instead of hours, so a test plan
# takes minutes instead of a night. Leave empty for normal timers (always, for real use).
# `dev` and release images ignore it. The app shows a "TEST TIMERS" tag while it's on.
VEHICLEMANAGER_TEST_MINUTES=

# Optional: the place data file (a GeoPackage) the server reads instead of the one in the
# image, e.g. /data/geodata-2027-01-01.gpkg. Leave empty to use the image's own. A file that
# can't be opened leaves place lookup off and shows the Admin a message.
VEHICLEMANAGER_GEODATA_FILE=
