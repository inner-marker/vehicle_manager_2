# Settings for deploy/compose.yaml. Copy to `.env` in the Project folder on the NAS
# and fill in. `.env` holds the credential: keep it on the NAS, never commit it.

# Which image to run: `dev` (newest build of dev), `milestone-<name>` (newest build of
# a milestone branch, e.g. milestone-p1-m3-nas-web), `sha-<commit>` (an exact build,
# for pinning or rollback), or a release version such as `0.1.0`.
VEHICLEMANAGER_IMAGE_TAG=dev

# The NAS user the container runs as: `id vehiclemanager` over SSH shows both.
VEHICLEMANAGER_UID=1030
VEHICLEMANAGER_GID=100

# Port on the NAS's loopback (127.0.0.1) that `tailscale serve` forwards to.
# Pick one nothing else on the NAS uses (avoid DSM's 5000/5001).
VEHICLEMANAGER_HOST_PORT=8410

# The Phase 1 test credential (decisions.md #024). Choose a long random value.
# Left empty, the server refuses every API request; that's deliberate.
VEHICLEMANAGER_TEST_CREDENTIAL=

# Optional: where nightly snapshots go, as a path *inside the container*. Leave empty for
# the default, /data/snapshots (the Project's data/snapshots folder). Only for a second
# disk mounted in compose.yaml (e.g. /snapshots for a USB disk); that folder is never
# created, so an unmounted disk makes the snapshot "skipped" instead of filling the pool.
VEHICLEMANAGER_SNAPSHOT_DIR=
