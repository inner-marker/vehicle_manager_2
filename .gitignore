# Build output (includes Dioxus CLI output under target/dx)
/target

# macOS
.DS_Store

# Local development databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
# ...except the migration fixtures, which are part of the tests
!crates/storage/tests/fixtures/*.sqlite

# Personal Claude Code settings (shared settings live in .claude/settings.json)
.claude/settings.local.json

# Deployment secrets: the NAS's .env holds the credential (deploy/.env.example is the template)
.env
deploy/.env
