# Build output (includes Dioxus CLI output under target/dx)
/target
# The spikes' own build output (each spike is its own workspace)
/spikes/*/target

# macOS
.DS_Store

# Local development databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
# ...except the migration fixtures, which are part of the tests
!crates/storage/tests/fixtures/*.sqlite
# The server's local development data folder (dx serve without VEHICLEMANAGER_DATA_DIR)
dev-data/

# The human's own setup (equipment, hosts), for agents to read; never committed (AGENTS.md §7)
/local/

# Personal Claude Code settings (shared settings live in .claude/settings.json)
.claude/settings.local.json

# Deployment secrets: the NAS's .env holds the credential (deploy/.env.example is the template)
.env
deploy/.env

# Geocoder data for development (scripts/geodata/fetch.sh; decision #059)
/.geodata/
